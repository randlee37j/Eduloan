;; Credit Scoring System for EduLoan\n;; Tracks borrower payment behavior and provides credit assessments\n\n(define-constant ERR_UNAUTHORIZED (err u200))\n(define-constant ERR_BORROWER_NOT_FOUND (err u201))\n(define-constant ERR_INSUFFICIENT_HISTORY (err u202))\n(define-constant ERR_INVALID_SCORE (err u203))\n(define-constant ERR_RECOMMENDATION_EXISTS (err u204))\n\n;; Credit score parameters\n(define-constant MAX_CREDIT_SCORE u850)\n(define-constant MIN_CREDIT_SCORE u300)\n(define-constant BASE_CREDIT_SCORE u650)\n(define-constant EXCELLENT_THRESHOLD u750)\n(define-constant GOOD_THRESHOLD u650)\n(define-constant FAIR_THRESHOLD u550)\n\n(define-data-var total-borrowers uint u0)\n\n;; Track borrower credit profiles\n(define-map credit-profiles\n  { borrower: principal }\n  {\n    total-loans: uint,\n    active-loans: uint,\n    completed-loans: uint,\n    defaulted-loans: uint,\n    total-payments: uint,\n    on-time-payments: uint,\n    late-payments: uint,\n    missed-payments: uint,\n    total-borrowed: uint,\n    total-repaid: uint,\n    current-score: uint,\n    last-updated: uint,\n    payment-streak: uint,\n    longest-streak: uint\n  }\n)\n\n;; Store credit score history\n(define-map score-history\n  { borrower: principal, update-id: uint }\n  {\n    previous-score: uint,\n    new-score: uint,\n    change-reason: (string-ascii 100),\n    update-block: uint\n  }\n)\n\n;; Loan recommendations for borrowers\n(define-map loan-recommendations\n  { borrower: principal }\n  {\n    recommended-amount: uint,\n    max-interest-rate: uint,\n    recommended-term: uint,\n    confidence-level: uint,\n    risk-category: (string-ascii 20),\n    last-calculated: uint\n  }\n)\n\n;; Update borrower credit profile after loan events\n(define-public (update-credit-after-loan-created (borrower principal) (loan-amount uint))\n  (let\n    (\n      (current-profile (get-or-create-profile borrower))\n      (new-total-loans (+ (get total-loans current-profile) u1))\n      (new-active-loans (+ (get active-loans current-profile) u1))\n      (new-total-borrowed (+ (get total-borrowed current-profile) loan-amount))\n      (updated-score (calculate-credit-score-internal current-profile))\n    )\n    (map-set credit-profiles\n      { borrower: borrower }\n      (merge current-profile {\n        total-loans: new-total-loans,\n        active-loans: new-active-loans,\n        total-borrowed: new-total-borrowed,\n        current-score: updated-score,\n        last-updated: stacks-block-height\n      })\n    )\n    (record-score-change borrower (get current-score current-profile) updated-score "NEW_LOAN")\n    (ok updated-score)\n  )\n)\n\n;; Update credit after payment made\n(define-public (update-credit-after-payment (borrower principal) (payment-amount uint) (was-on-time bool))\n  (let\n    (\n      (current-profile (get-or-create-profile borrower))\n      (new-total-payments (+ (get total-payments current-profile) u1))\n      (new-on-time (if was-on-time (+ (get on-time-payments current-profile) u1) (get on-time-payments current-profile)))\n      (new-late (if was-on-time (get late-payments current-profile) (+ (get late-payments current-profile) u1)))\n      (new-repaid (+ (get total-repaid current-profile) payment-amount))\n      (new-streak (if was-on-time (+ (get payment-streak current-profile) u1) u0))\n      (new-longest-streak (if (> new-streak (get longest-streak current-profile)) new-streak (get longest-streak current-profile)))\n      (updated-score (calculate-credit-score-with-payment current-profile was-on-time))\n      (change-reason (if was-on-time "ON_TIME_PAYMENT" "LATE_PAYMENT"))\n    )\n    (map-set credit-profiles\n      { borrower: borrower }\n      (merge current-profile {\n        total-payments: new-total-payments,\n        on-time-payments: new-on-time,\n        late-payments: new-late,\n        total-repaid: new-repaid,\n        payment-streak: new-streak,\n        longest-streak: new-longest-streak,\n        current-score: updated-score,\n        last-updated: stacks-block-height\n      })\n    )\n    (record-score-change borrower (get current-score current-profile) updated-score change-reason)\n    (ok updated-score)\n  )\n)\n\n;; Update credit after loan completion\n(define-public (update-credit-after-loan-completed (borrower principal))\n  (let\n    (\n      (current-profile (unwrap! (map-get? credit-profiles { borrower: borrower }) ERR_BORROWER_NOT_FOUND))\n      (new-active (- (get active-loans current-profile) u1))\n      (new-completed (+ (get completed-loans current-profile) u1))\n      (updated-score (+ (get current-score current-profile) u20))\n      (final-score (if (> updated-score MAX_CREDIT_SCORE) MAX_CREDIT_SCORE updated-score))\n    )\n    (map-set credit-profiles\n      { borrower: borrower }\n      (merge current-profile {\n        active-loans: new-active,\n        completed-loans: new-completed,\n        current-score: final-score,\n        last-updated: stacks-block-height\n      })\n    )\n    (record-score-change borrower (get current-score current-profile) final-score "LOAN_COMPLETED")\n    (ok final-score)\n  )\n)\n\n;; Update credit after default\n(define-public (update-credit-after-default (borrower principal))\n  (let\n    (\n      (current-profile (unwrap! (map-get? credit-profiles { borrower: borrower }) ERR_BORROWER_NOT_FOUND))\n      (new-active (- (get active-loans current-profile) u1))\n      (new-defaulted (+ (get defaulted-loans current-profile) u1))\n      (score-penalty u100)\n      (updated-score (if (> (get current-score current-profile) score-penalty) \n                        (- (get current-score current-profile) score-penalty) \n                        MIN_CREDIT_SCORE))\n    )\n    (map-set credit-profiles\n      { borrower: borrower }\n      (merge current-profile {\n        active-loans: new-active,\n        defaulted-loans: new-defaulted,\n        current-score: updated-score,\n        payment-streak: u0,\n        last-updated: stacks-block-height\n      })\n    )\n    (record-score-change borrower (get current-score current-profile) updated-score "LOAN_DEFAULT")\n    (ok updated-score)\n  )\n)\n\n;; Generate personalized loan recommendations\n(define-public (generate-loan-recommendation (borrower principal))\n  (let\n    (\n      (profile (unwrap! (map-get? credit-profiles { borrower: borrower }) ERR_BORROWER_NOT_FOUND))\n      (credit-score (get current-score profile))\n      (recommendation (calculate-recommendation profile credit-score))\n    )\n    (asserts! (>= (get total-payments profile) u3) ERR_INSUFFICIENT_HISTORY)\n    \n    (map-set loan-recommendations\n      { borrower: borrower }\n      recommendation\n    )\n    (ok recommendation)\n  )\n)\n\n;; Get borrower's credit profile\n(define-read-only (get-credit-profile (borrower principal))\n  (map-get? credit-profiles { borrower: borrower })\n)\n\n;; Get credit score with rating\n(define-read-only (get-credit-score-with-rating (borrower principal))\n  (match (map-get? credit-profiles { borrower: borrower })\n    profile \n    (let\n      (\n        (score (get current-score profile))\n        (rating (get-credit-rating score))\n      )\n      (ok { score: score, rating: rating, last-updated: (get last-updated profile) })\n    )\n    ERR_BORROWER_NOT_FOUND\n  )\n)\n\n;; Get loan recommendation\n(define-read-only (get-loan-recommendation (borrower principal))\n  (map-get? loan-recommendations { borrower: borrower })\n)\n\n;; Get score history\n(define-read-only (get-score-history (borrower principal) (update-id uint))\n  (map-get? score-history { borrower: borrower, update-id: update-id })\n)\n\n;; Check if borrower qualifies for amount\n(define-read-only (qualifies-for-loan (borrower principal) (requested-amount uint))\n  (match (get-loan-recommendation borrower)\n    recommendation\n    (let\n      (\n        (max-amount (get recommended-amount recommendation))\n        (profile (unwrap-panic (map-get? credit-profiles { borrower: borrower })))\n        (score (get current-score profile))\n      )\n      (ok {\n        qualifies: (<= requested-amount max-amount),\n        max-qualified: max-amount,\n        credit-score: score,\n        risk-category: (get risk-category recommendation)\n      })\n    )\n    (err u0)\n  )\n)\n\n;; Private helper functions\n(define-private (get-or-create-profile (borrower principal))\n  (default-to\n    {\n      total-loans: u0,\n      active-loans: u0,\n      completed-loans: u0,\n      defaulted-loans: u0,\n      total-payments: u0,\n      on-time-payments: u0,\n      late-payments: u0,\n      missed-payments: u0,\n      total-borrowed: u0,\n      total-repaid: u0,\n      current-score: BASE_CREDIT_SCORE,\n      last-updated: stacks-block-height,\n      payment-streak: u0,\n      longest-streak: u0\n    }\n    (map-get? credit-profiles { borrower: borrower })\n  )\n)\n\n(define-private (calculate-credit-score-internal (profile { total-loans: uint, active-loans: uint, completed-loans: uint, defaulted-loans: uint, total-payments: uint, on-time-payments: uint, late-payments: uint, missed-payments: uint, total-borrowed: uint, total-repaid: uint, current-score: uint, last-updated: uint, payment-streak: uint, longest-streak: uint }))\n  (let\n    (\n      (payment-ratio (if (> (get total-payments profile) u0)\n                       (/ (* (get on-time-payments profile) u100) (get total-payments profile))\n                       u100))\n      (completion-ratio (if (> (get total-loans profile) u0)\n                         (/ (* (get completed-loans profile) u100) (get total-loans profile))\n                         u100))\n      (default-penalty (* (get defaulted-loans profile) u50))\n      (streak-bonus (min (* (get payment-streak profile) u5) u50))\n      (base-score (+ BASE_CREDIT_SCORE \n                     (/ (* payment-ratio u100) u100)\n                     (/ (* completion-ratio u50) u100)\n                     streak-bonus))\n      (final-score (if (> base-score default-penalty) (- base-score default-penalty) MIN_CREDIT_SCORE))\n    )\n    (min final-score MAX_CREDIT_SCORE)\n  )\n)\n\n(define-private (calculate-credit-score-with-payment (profile { total-loans: uint, active-loans: uint, completed-loans: uint, defaulted-loans: uint, total-payments: uint, on-time-payments: uint, late-payments: uint, missed-payments: uint, total-borrowed: uint, total-repaid: uint, current-score: uint, last-updated: uint, payment-streak: uint, longest-streak: uint }) (was-on-time bool))\n  (let\n    (\n      (base-score (calculate-credit-score-internal profile))\n      (payment-impact (if was-on-time u10 u0))\n      (late-penalty (if was-on-time u0 u15))\n      (updated-score (+ (- base-score late-penalty) payment-impact))\n    )\n    (max (min updated-score MAX_CREDIT_SCORE) MIN_CREDIT_SCORE)\n  )\n)\n\n(define-private (calculate-recommendation (profile { total-loans: uint, active-loans: uint, completed-loans: uint, defaulted-loans: uint, total-payments: uint, on-time-payments: uint, late-payments: uint, missed-payments: uint, total-borrowed: uint, total-repaid: uint, current-score: uint, last-updated: uint, payment-streak: uint, longest-streak: uint }) (credit-score uint))\n  (let\n    (\n      (base-amount (if (>= credit-score EXCELLENT_THRESHOLD) u100000\n                     (if (>= credit-score GOOD_THRESHOLD) u50000\n                       (if (>= credit-score FAIR_THRESHOLD) u25000 u10000))))\n      (max-rate (if (>= credit-score EXCELLENT_THRESHOLD) u400\n                  (if (>= credit-score GOOD_THRESHOLD) u600\n                    (if (>= credit-score FAIR_THRESHOLD) u800 u1000))))\n      (term (if (>= credit-score EXCELLENT_THRESHOLD) u60\n              (if (>= credit-score GOOD_THRESHOLD) u48\n                (if (>= credit-score FAIR_THRESHOLD) u36 u24))))\n      (confidence (if (>= credit-score EXCELLENT_THRESHOLD) u95\n                    (if (>= credit-score GOOD_THRESHOLD) u85\n                      (if (>= credit-score FAIR_THRESHOLD) u70 u50))))\n      (risk-cat (if (>= credit-score EXCELLENT_THRESHOLD) "LOW"\n                  (if (>= credit-score GOOD_THRESHOLD) "MEDIUM"\n                    (if (>= credit-score FAIR_THRESHOLD) "HIGH" "VERY_HIGH"))))\n    )\n    {\n      recommended-amount: base-amount,\n      max-interest-rate: max-rate,\n      recommended-term: term,\n      confidence-level: confidence,\n      risk-category: risk-cat,\n      last-calculated: stacks-block-height\n    }\n  )\n)\n\n(define-private (get-credit-rating (score uint))\n  (if (>= score EXCELLENT_THRESHOLD) "EXCELLENT"\n    (if (>= score GOOD_THRESHOLD) "GOOD"\n      (if (>= score FAIR_THRESHOLD) "FAIR" "POOR")))\n)\n\n(define-private (record-score-change (borrower principal) (old-score uint) (new-score uint) (reason (string-ascii 100)))\n  (let\n    (\n      (update-count (+ (default-to u0 (get-update-count borrower)) u1))\n    )\n    (map-set score-history\n      { borrower: borrower, update-id: update-count }\n      {\n        previous-score: old-score,\n        new-score: new-score,\n        change-reason: reason,\n        update-block: stacks-block-height\n      }\n    )\n  )\n)\n\n(define-private (get-update-count (borrower principal))\n  u1 ;; Simplified for this implementation\n)\n